# Cole estas variáveis na aba "Environment" do app no Easypanel.

# Banco do rodízio: "Internal Connection URL" do serviço Postgres do Easypanel.
# Sem ele o site funciona e a alternância é feita no navegador de cada visitante.
DATABASE_URL=postgres://usuario:senha@host:5432/yurirodizio

# ID do Meta Pixel (opcional, só números). Ativa PageView e o evento "Contact" no envio ao WhatsApp.
META_PIXEL_ID=

# (Opcional) Domínio público. Se ficar vazio, é detectado automaticamente.
# SITE_URL=https://simulador.seudominio.com.br
