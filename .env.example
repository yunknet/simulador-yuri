# ---------- Servidor (variáveis de ambiente do app no Easypanel) ----------
# Porta interna do container
PORT=3000
# Banco PostgreSQL do rodízio. Use a "Internal Connection URL" do serviço Postgres do Easypanel.
# Sem banco, o site funciona normalmente e o rodízio é feito no navegador de cada visitante.
DATABASE_URL=postgres://usuario:senha@host:5432/yurirodizio

# ---------- Front-end (Build Args no Easypanel) ----------
# URL pública do simulador, sem barra no final (prévia do link no WhatsApp/Instagram)
VITE_SITE_URL=https://simulador.seudominio.com.br
# ID do Meta Pixel (opcional) — dispara PageView e "Contact" ao enviar para o WhatsApp
VITE_META_PIXEL_ID=
# Deixe vazio: a API roda no mesmo domínio (/api)
VITE_API_URL=
